    "Sandbox_StayWithMe_SpeechDuration_Values_option3": "Very long (9 s)",
    "Sandbox_StayWithMe_RelationshipGainMultiplier": "Relationship Gain Multiplier",
    "Sandbox_StayWithMe_RelationshipGainMultiplier_tooltip": "Scales how fast friendship and romance grow from all sources. Applied after the daily caps and only to gains, never to losses. 1.0 = default.",
    "Sandbox_StayWithMe_DailyFriendCap": "Daily Friendship Cap",
    "Sandbox_StayWithMe_DailyFriendCap_tooltip": "Base friendship gained per day from talking, deeds and gifts before tier and relaxed bonuses. Default 10.",
    "Sandbox_StayWithMe_DailyRomanceCap": "Daily Romance Cap",
    "Sandbox_StayWithMe_DailyRomanceCap_tooltip": "Base romance gained per day before tier and relaxed bonuses. Only applies once romance is open. Default 6.",
    "Sandbox_StayWithMe_GiftAffectionMultiplier": "Gift Affection Multiplier",
    "Sandbox_StayWithMe_GiftAffectionMultiplier_tooltip": "Scales how much affection a given gift item is worth, before the daily gift cap. 1.0 = default.",
    "Sandbox_StayWithMe_DailyGiftCapFriend": "Daily Gift Cap (Friendship)",
    "Sandbox_StayWithMe_DailyGiftCapFriend_tooltip": "Base friendship that gifts can add per day, before tier bonuses. Separate from the talk cap. Default 3.",
    "Sandbox_StayWithMe_DailyGiftCapRomance": "Daily Gift Cap (Romance)",
    "Sandbox_StayWithMe_DailyGiftCapRomance_tooltip": "Base romance that gifts can add per day, before tier bonuses. Separate from the talk cap. Default 1.",
    "Sandbox_StayWithMe_RomanceRequirementFriend": "Romance: Friendship Required",
    "Sandbox_StayWithMe_RomanceRequirementFriend_tooltip": "Friendship she needs before romance can open (0-100). Default 30.",
    "Sandbox_StayWithMe_RomanceRequirementDays": "Romance: Days Required",
    "Sandbox_StayWithMe_RomanceRequirementDays_tooltip": "Days she must have known you before romance can open. Default 2.",
    "Sandbox_StayWithMe_CarryCapacityBonus": "Carry Capacity Bonus",
    "Sandbox_StayWithMe_CarryCapacityBonus_tooltip": "Flat bonus to her carry capacity on top of the Strength-based value (0-20). Default 0.",
    "Sandbox_StayWithMe_MoodEffectMultiplier": "Mood Effect Multiplier",
    "Sandbox_StayWithMe_MoodEffectMultiplier_tooltip": "Scales how much talking and her presence relieve boredom, unhappiness, stress, anger and pain. 1.0 = default.",

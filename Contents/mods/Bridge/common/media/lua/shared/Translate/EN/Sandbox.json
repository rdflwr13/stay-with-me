{
    "Sandbox_StayWithMe": "Stay With Me",
    "Sandbox_StayWithMe_ForceSpawnNearPlayer": "Force spawn near player (debug)",
    "Sandbox_StayWithMe_ForceSpawnNearPlayer_tooltip": "Debug option. When enabled, the companion is respawned beside the player if missing and forced into follow mode. Use only for testing.",
    "Sandbox_StayWithMe_CarSeatPuppet": "Show companion in the car seat (singleplayer)",
    "Sandbox_StayWithMe_CarSeatPuppet_tooltip": "Singleplayer only. While she rides inside a vehicle, a temporary look-alike sits in a passenger seat so the car does not look empty. It is cosmetic: the real companion is still the one who gets out. Default off.",
    "Sandbox_StayWithMe_MeetMarkerRange": "Meet marker range",
    "Sandbox_StayWithMe_MeetMarkerRange_tooltip": "Singleplayer only. Maximum distance at which the companion meet marker is shown. The marker shows direction and distance. This does not change where the companion spawns. Default: 500 m.",
    "Sandbox_StayWithMe_MeetMarkerRange_Values_option1": "250 m",
    "Sandbox_StayWithMe_MeetMarkerRange_Values_option2": "500 m",
    "Sandbox_StayWithMe_MeetMarkerRange_Values_option3": "750 m",
    "Sandbox_StayWithMe_MeetMarkerRange_Values_option4": "1000 m",
    "Sandbox_StayWithMe_NightSight": "Darkness Impairment",
    "Sandbox_StayWithMe_NightSight_tooltip": "How much darkness reduces the distance at which she can notice threats. Off keeps her normal detection range. Mild, Realistic and Harsh reduce it more as it gets darker. Her flashlight helps in the dark. Default: Off.",
    "Sandbox_StayWithMe_NightSight_Values_option1": "Off",
    "Sandbox_StayWithMe_NightSight_Values_option2": "Mild",
    "Sandbox_StayWithMe_NightSight_Values_option3": "Realistic",
    "Sandbox_StayWithMe_NightSight_Values_option4": "Harsh",
    "Sandbox_StayWithMe_ExhaustionImpact": "Stamina Exhaustion Impact",
    "Sandbox_StayWithMe_ExhaustionImpact_tooltip": "How much low stamina affects the companion. Default keeps the current penalties. Player-like adds player-style movement, sprint, swing and crit penalties and removes miss and damage penalties. Harsh keeps the current combat penalties, adds player-style movement, and makes work rest earlier. Default: Default.",

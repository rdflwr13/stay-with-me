{
    "Sandbox_StayWithMe": "Stay With Me",
    "Sandbox_StayWithMe_RelationshipGainMultiplier": "Beziehungszuwachs-Multiplikator",
    "Sandbox_StayWithMe_RelationshipGainMultiplier_tooltip": "Skaliert, wie schnell Freundschaft und Romantik aus allen Quellen wachsen. Wird nach den täglichen Obergrenzen und nur auf Gewinne angewendet, niemals auf Verluste. 1.0 = Standard.",
    "Sandbox_StayWithMe_DailyFriendCap": "Tägliche Freundschafts-Obergrenze",
    "Sandbox_StayWithMe_DailyFriendCap_tooltip": "Basis-Freundschaft, die pro Tag durch Reden, Taten und Geschenke vor Rang- und Entspannungsboni gewonnen wird. Standard 6.",
    "Sandbox_StayWithMe_DailyRomanceCap": "Tägliche Romantik-Obergrenze",
    "Sandbox_StayWithMe_DailyRomanceCap_tooltip": "Basis-Romantik, die pro Tag vor Rang- und Entspannungsboni gewonnen wird. Gilt erst, wenn die Romantik freigeschaltet ist. Standard 3.",
    "Sandbox_StayWithMe_GiftAffectionMultiplier": "Geschenk-Zuneigungs-Multiplikator",
    "Sandbox_StayWithMe_GiftAffectionMultiplier_tooltip": "Skaliert den Zuneigungswert eines bestimmten Geschenks vor der täglichen Geschenk-Obergrenze. 1.0 = Standard.",
    "Sandbox_StayWithMe_DailyGiftCapFriend": "Tägliche Geschenk-Obergrenze (Freundschaft)",
    "Sandbox_StayWithMe_DailyGiftCapFriend_tooltip": "Basis-Freundschaft, die Geschenke pro Tag vor Rangboni hinzufügen können. Unabhängig von der Obergrenze fürs Reden. Standard 3.",
    "Sandbox_StayWithMe_DailyGiftCapRomance": "Tägliche Geschenk-Obergrenze (Romantik)",
    "Sandbox_StayWithMe_DailyGiftCapRomance_tooltip": "Basis-Romantik, die Geschenke pro Tag vor Rangboni hinzufügen können. Unabhängig von der Obergrenze fürs Reden. Standard 1.",
    "Sandbox_StayWithMe_RomanceRequirementFriend": "Romantik: Erforderliche Freundschaft",
    "Sandbox_StayWithMe_RomanceRequirementFriend_tooltip": "Freundschaft, die sie benötigt, bevor die Romantik freigeschaltet werden kann (0-100). Standard 30.",
    "Sandbox_StayWithMe_RomanceRequirementDays": "Romantik: Erforderliche Tage",
    "Sandbox_StayWithMe_RomanceRequirementDays_tooltip": "Tage, die sie dich kennen muss, bevor die Romantik freigeschaltet werden kann. Standard 2.",
    "Sandbox_StayWithMe_CarryCapacityBonus": "Tragekapazitäts-Bonus",
    "Sandbox_StayWithMe_CarryCapacityBonus_tooltip": "Ein fester Bonus auf ihre Tragekapazität zusätzlich zu dem auf Stärke basierenden Wert (0-20). Standard 0.",

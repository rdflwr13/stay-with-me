    "Sandbox_StayWithMe_ForceSpawnNearPlayer": "Forza la comparsa vicino al giocatore (debug)",
    "Sandbox_StayWithMe_ForceSpawnNearPlayer_tooltip": "Opzione di debug. Se abilitata, il compagno viene fatto ricomparire accanto al giocatore qualora fosse assente e viene forzato in modalità Segui. Utilizzare soltanto per i test.",
    "Sandbox_StayWithMe_CarSeatPuppet": "Mostra il/la companion sul sedile dell'auto (giocatore singolo)",
    "Sandbox_StayWithMe_CarSeatPuppet_tooltip": "Solo in giocatore singolo. Quando il/la companion viaggia all'interno di un veicolo, una sua copia temporanea viene visualizzata sul sedile del passeggero, evitando che l'auto sembri vuota. L'effetto è puramente estetico: sarà sempre la vera compagna a scendere dal veicolo. Disabilitato per impostazione predefinita.",
    "Sandbox_StayWithMe_MeetMarkerRange": "Distanza dell'indicatore di incontro",
    "Sandbox_StayWithMe_MeetMarkerRange_tooltip": "Solo in giocatore singolo. Distanza massima alla quale viene visualizzato l'indicatore di incontro con il/la companion. L'indicatore mostra la direzione e la distanza. Questa impostazione non modifica il luogo in cui compare il/la companion. Predefinito: 500 m.",
    "Sandbox_StayWithMe_MeetMarkerRange_Values_option1": "250 m",
    "Sandbox_StayWithMe_MeetMarkerRange_Values_option2": "500 m",
    "Sandbox_StayWithMe_MeetMarkerRange_Values_option3": "750 m",
    "Sandbox_StayWithMe_MeetMarkerRange_Values_option4": "1000 m",
    "Sandbox_StayWithMe_NightSight": "Visibilità ridotta dall'oscurità",
    "Sandbox_StayWithMe_NightSight_tooltip": "Determina quanto l'oscurità riduce la distanza alla quale il/la companion può individuare le minacce. Disattivato mantiene il normale raggio di rilevamento. Lieve, Realistico e Severo lo riducono progressivamente all'aumentare dell'oscurità. La sua torcia la aiuta a vedere al buio. Predefinito: Disattivato.",
    "Sandbox_StayWithMe_NightSight_Values_option1": "Disattivato",
    "Sandbox_StayWithMe_NightSight_Values_option2": "Lieve",
    "Sandbox_StayWithMe_NightSight_Values_option3": "Realistico",
    "Sandbox_StayWithMe_NightSight_Values_option4": "Severo",
    "Sandbox_StayWithMe_SpeechFont": "Dimensione del testo dei dialoghi",
    "Sandbox_StayWithMe_SpeechFont_tooltip": "Dimensione del testo dei dialoghi del/la companion visualizzati sopra la sua testa e all'interno dei veicoli. Normale mantiene le dimensioni e l'aspetto precedenti. Grande ed Enorme aumentano le dimensioni del testo. Predefinito: Normale.",
    "Sandbox_StayWithMe_SpeechFont_Values_option1": "Normale (predefinito)",
    "Sandbox_StayWithMe_SpeechFont_Values_option2": "Grande",
    "Sandbox_StayWithMe_SpeechFont_Values_option3": "Enorme",
    "Sandbox_StayWithMe_SpeechDuration": "Durata dei dialoghi",
    "Sandbox_StayWithMe_SpeechDuration_tooltip": "Determina per quanto tempo i dialoghi del/la companion visualizzati sopra la sua testa e all'interno dei veicoli rimangono sullo schermo. Normale corrisponde a 5,25 secondi, Lunga a 7 secondi e Molto lunga a 9 secondi. Predefinito: Normale.",
    "Sandbox_StayWithMe_SpeechDuration_Values_option1": "Normale (5,25 s)",
    "Sandbox_StayWithMe_SpeechDuration_Values_option2": "Lunga (7 s)",
    "Sandbox_StayWithMe_SpeechDuration_Values_option3": "Molto lunga (9 s)"
}
